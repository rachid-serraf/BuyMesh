TZ=UTC
SPRING_PROFILES_ACTIVE=docker
E2E_GATEWAY_PORT=18080

# new JWT key pair, same format as your real keys, never the production ones
JWT_PRIVATE_
JWT_PUBLIC_
JWT_EXPIRATION=3600000
INTERNAL_API_KEY=e2e-internal-key
SSL_PASSWORD=e2e-changeit

# important for tests: they send many requests quickly
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CAPACITY=1000
RATE_LIMIT_REFILL_MINUTES=1

USER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8084
USER_MONGO_DB=user_e2e
USER_MONGO_USERNAME=e2e
USER_MONGO_PASSWORD=e2e
PRODUCT_MONGO_DB_NAME=product_e2e
PRODUCT_MONGO_DB_USER=e2e
PRODUCT_MONGO_DB_PWD=e2e
MEDIA_MONGO_DB_NAME=media_e2e
MEDIA_MONGO_DB_USER=e2e
MEDIA_MONGO_DB_PWD=e2e
ORDER_MONGO_DB_NAME=order_e2e
ORDER_MONGO_DB_USER=e2e
ORDER_MONGO_DB_PWD=e2e