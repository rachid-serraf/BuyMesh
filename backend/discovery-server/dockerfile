# Stage 1: Build the application
# Use the multi-platform Maven image; the unversioned Alpine variant is not
# available for every platform.
FROM maven:3.8-eclipse-temurin-11 AS build
WORKDIR /app

# Copy the pom.xml and source code
COPY pom.xml .
COPY src ./src

# Build the application (skipping tests for speed)
RUN mvn clean package -DskipTests

# Stage 2: Create the final lightweight image
# The unversioned Alpine JRE tag is no longer published for every platform.
# Temurin 11 JRE on Alpine keeps the runtime aligned with the Java 11 build.
FROM eclipse-temurin:11-jre
WORKDIR /app

# Copy ONLY the built jar from the build stage
COPY --from=build /app/target/*.jar app.jar

EXPOSE 8761

ENTRYPOINT ["java", "-jar", "app.jar"]
